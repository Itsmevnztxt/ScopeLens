# ScopeLens Frontend Environment Variables
# Salin file ini menjadi .env.local untuk mengaktifkan backend Supabase Cloud / Self-Hosted.
# Jika dikosongkan, ScopeLens tetap berjalan penuh dalam Demo Mode (client-side + localStorage).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opsional: aktifkan hanya jika ingin menjalankan integration test terhadap instance Supabase lokal/staging
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=
