# Salin file ini ke docker/.env sebelum menjalankan `docker compose up -d` di VPS.
# JANGAN PERNAH meng-commit file .env asli ke repository Git.

DOMAIN=scopelens.domainanda.com
PUBLIC_URL=https://scopelens.domainanda.com

# Buat password kuat: openssl rand -hex 24
POSTGRES_PASSWORD=ganti_dengan_password_kuat_minimal_24_karakter

# Buat JWT secret minimal 32 karakter: openssl rand -base64 48
JWT_SECRET=ganti_dengan_jwt_secret_minimal_32_karakter

# Konfigurasi SMTP untuk email verifikasi & reset password
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
SMTP_ADMIN_EMAIL=noreply@domainanda.com
